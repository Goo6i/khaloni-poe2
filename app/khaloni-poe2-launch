#!/usr/bin/env bash
# The shortcuts portal needs an app id; host apps get one from an
# app-<id>-<n>.scope systemd unit plus a desktop entry whose FILE NAME
# matches the app id the binary registers (dev.goo6i.khalonipoe2). The
# entry is generated here so Exec always points at this checkout's binary.
# Diagnostics always go to ~/.cache/khaloni-poe2/last-run.log (overwritten
# per run) so timing issues can be analyzed after any session.
set -euo pipefail
BIN="$(cd "$(dirname "$0")/.." && pwd)/target/release/khaloni-poe2"
APP_ID="dev.goo6i.khalonipoe2"
mkdir -p "$HOME/.local/share/applications"
cat > "$HOME/.local/share/applications/$APP_ID.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=khaloni-poe2
Exec=$BIN
NoDisplay=true
EOF
# Stale entries from before the project rename.
rm -f "$HOME/.local/share/applications/dev.goo6i.poe2lens.desktop" \
      "$HOME/.local/share/applications/org.poe2lens.App.desktop" \
      "$HOME/.local/share/applications/org.khalonipoe2.App.desktop"
LOG_DIR="$HOME/.cache/khaloni-poe2"
mkdir -p "$LOG_DIR"
[ -f "$LOG_DIR/last-run.log" ] && mv -f "$LOG_DIR/last-run.log" "$LOG_DIR/prev-run.log"
exec systemd-run --user --scope --unit="app-$APP_ID-$RANDOM.scope" \
  "$BIN" "$@" \
  2> "$LOG_DIR/last-run.log"
